{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["stage", "scene_file", "render_quality_grade", "draft_mode"],
  "properties": {
    "stage": { "const": "render" },
    "scene_file": { "type": "string" },
    "render_quality_grade": { "enum": ["low", "medium", "high"] },
    "draft_mode": { "type": "boolean" }
  },
  "additionalProperties": true
}
