{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.local/schemas/stream_frame.json",
  "title": "StreamFrame",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "frame_id",
    "sent_at",
    "frame_type",
    "overlays"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "frame_id": {
      "type": "string",
      "minLength": 1
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "frame_type": {
      "type": "string",
      "enum": [
        "overlay_update",
        "tracking_update",
        "heartbeat",
        "error"
      ]
    },
    "overlays": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/overlay"
      }
    },
    "tracking_state": {
      "$ref": "#/$defs/tracking_state_ref"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bbox",
        "label",
        "confidence",
        "ui_layer",
        "overlay_type",
        "action_required"
      ],
      "properties": {
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ui_layer": {
          "type": "string",
          "enum": [
            "background",
            "midground",
            "foreground",
            "hud"
          ]
        },
        "overlay_type": {
          "type": "string",
          "enum": [
            "diagnostic",
            "hazard",
            "info",
            "reference"
          ]
        },
        "action_required": {
          "type": "boolean"
        },
        "mask_rle": {
          "type": "string",
          "minLength": 1
        },
        "depth_value": {
          "type": "number"
        },
        "object_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tracking_state_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "tracked_count"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "inactive",
            "initializing",
            "tracking",
            "lost"
          ]
        },
        "tracked_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
