{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.local/schemas/tracking_state.json",
  "title": "TrackingState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "state",
    "tracked_objects",
    "updated_at"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "inactive",
        "initializing",
        "tracking",
        "lost"
      ]
    },
    "tracked_objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tracked_object"
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "tracked_object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "label",
        "bbox",
        "confidence",
        "last_seen_ms"
      ],
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "depth_value": {
          "type": "number"
        },
        "last_seen_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
