{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.local/schemas/overlay_response.json",
  "title": "OverlayResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "session_id",
    "created_at",
    "overlays"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "overlays": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/overlay"
      }
    },
    "tracking_state": {
      "type": "string",
      "enum": [
        "inactive",
        "initializing",
        "tracking",
        "lost"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bbox",
        "label",
        "confidence",
        "ui_layer",
        "overlay_type",
        "action_required"
      ],
      "properties": {
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ui_layer": {
          "type": "string",
          "enum": [
            "background",
            "midground",
            "foreground",
            "hud"
          ]
        },
        "overlay_type": {
          "type": "string",
          "enum": [
            "diagnostic",
            "hazard",
            "info",
            "reference"
          ]
        },
        "action_required": {
          "type": "boolean"
        },
        "mask_rle": {
          "type": "string",
          "minLength": 1
        },
        "depth_value": {
          "type": "number"
        },
        "object_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
