# -----------------------------------------------------------------------------
# AURA environment variables
# Copy to `.env` locally and replace placeholder values.
# -----------------------------------------------------------------------------

# Runtime environment
ENVIRONMENT=development

# Server bind and TLS
# These names match the vars used in scripts/startup/start_server.sh
AURA_HOST=0.0.0.0
AURA_PORT=8443
AURA_USE_HTTPS=true
AURA_SSL_CERTFILE=./config/ssl/localhost+ip.pem
AURA_SSL_KEYFILE=./config/ssl/localhost+ip-key.pem

# CORS (comma-separated origins)
AURA_CORS_ALLOWED_ORIGINS=https://localhost:5173,https://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5173

# Pipeline controls
AURA_PHASE=1
AURA_DEFAULT_QUERY=What am I looking at?
AURA_TOTAL_TIMEOUT_MS=2000
AURA_FRAME_DROP_THRESHOLD_MS=300
AURA_REQUERY_INTERVAL_MS=2500

# Model/backend paths
AURA_MODELS_ROOT=./models
AURA_MODEL_CACHE_DIR=./models/cache

# VLM (vLLM OpenAI-compatible endpoint)
AURA_VLM_ENDPOINT=http://127.0.0.1:8000/v1
AURA_VLM_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct
AURA_VLM_TIMEOUT_MS=1800

# Audio backend
AURA_AUDIO_MODEL_PATH=whisper/base
AURA_AUDIO_MAX_DURATION_SECONDS=12

# Segmentation backend
AURA_SAM2_CHECKPOINT=sam2/sam2_large.pt

# Depth backend
AURA_DEPTH_ENABLED=false
AURA_DEPTH_CHECKPOINT=depth/depth_anything_v2.pth

# Optional stretch systems
AURA_GENERATION_ENABLED=false
AURA_AGENTS_ENABLED=false

# Demo/fallback assets
AURA_FALLBACK_VIDEO=./assets/fallback/demo.mp4
AURA_FALLBACK_PAYLOAD=./tests/fixtures/overlay/fallback_overlay.json
